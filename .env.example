# Copy this to .env.local and fill in your values

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Site URL (used for Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://tarrysingh.com

# ── Humanoid Ascendancy (/humanoid, /humanoid/deck) — premium gating ──
# There is NO free unlock in production. The package + the 60 workshop
# pages gate on HAEntitlement; "Get the package / Get access" buttons send
# the buyer to Stripe and NEVER grant access locally.
#
# Stripe Payment Links (public share URLs from the Stripe dashboard — these
# are NOT secret keys). Per-SKU; WORKSHOP / CERTIFICATION fall back to the
# FULL link when unset. When none are set the buttons fall back to the
# earthscan book-a-meeting page (still no free unlock).
NEXT_PUBLIC_STRIPE_LINK_FULL=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_WORKSHOP=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_LINK_CERTIFICATION=https://buy.stripe.com/...
# Dev-only preview escape hatch — set to "1" ONLY on .env.local to explore
# the gated content while building. MUST stay unset on Vercel (prod), or the
# "Preview (demo)" free-unlock buttons reappear.
# NEXT_PUBLIC_HA_DEMO=1

# PANORAIMA Dashboard (Basic Auth on /experiments/panoraima/*)
PANORAIMA_USER=utrecht
PANORAIMA_PASS=@dm1n_s3cur3

# RealAI-CRM webhook bridge (Dispatches newsletter → CRM contact + cadence)
# Posts HMAC-SHA256-signed payloads to RealAI-CRM at /api/webhooks/tarrysingh.
# Set on the DK AI Lab Pro Vercel project across Dev / Preview / Prod.
# When CRM_WEBHOOK_URL is empty the /api/newsletter/subscribe handler falls
# back to log-only mode (still returns 200 to the form) so subscriptions
# are never lost during CRM downtime.
CRM_WEBHOOK_URL=https://crm.realai.eu/api/webhooks/tarrysingh
CRM_WEBHOOK_SECRET=replace-with-shared-secret-from-realai-crm
CRM_UNSUBSCRIBE_TOKEN_SECRET=replace-with-different-shared-secret

# LinkedIn syndication bridge (Dispatches blog post → LinkedIn ugcPosts)
# tarrysingh-com never sees the LinkedIn OAuth token — the token is stored
# in RealAI-CRM and the CRM dispatches the actual ugcPosts call. This site
# only signs and forwards a SyndicationPayloadV1 to the CRM.
# When LINKEDIN_SYNDICATION_URL is empty the route falls back to log-only.
LINKEDIN_SYNDICATION_URL=https://crm.realai.eu/api/integrations/linkedin/syndicate
LINKEDIN_SYNDICATION_SECRET=replace-with-shared-secret-from-realai-crm
# Deploy-only admin token for /api/integrations/linkedin/{syndicate,preview}.
# Tarry or the publish hook calls these endpoints with this header:
#   X-Tarrysingh-Admin-Token: <value>
# Fail-closed at 503 when unset, 401 on mismatch. Never expose this to the
# client.
LINKEDIN_ADMIN_TOKEN=replace-with-long-random-string

# ── Studio Editor (/studio/*) — single-user WYSIWYG composer ─────────
# Basic-Auth gate for /studio/* and /api/studio/*. Fails closed (401)
# when either is missing. Same pattern as PANORAIMA_USER / PASS.
STUDIO_USER=studio
STUDIO_PASS=replace-with-strong-password

# Fine-grained GitHub PAT scoped to TarrySingh/tarrysingh-com with
# `Contents: read & write`. The Studio's Publish button commits the
# generated content/blog/<slug>.mdx straight to main via the
# GitHub Contents API; Vercel auto-deploys on the push.
# Mint at: github.com/settings/personal-access-tokens?type=beta
STUDIO_GITHUB_TOKEN=github_pat_...

# Anthropic SDK model for /api/studio/ai/* AND the daily Dispatch generator
# (ai-backup-writer). Defaults to claude-sonnet-4-6 — switched from
# claude-opus-4-8 on 2026-06-18 to cut the ~$1-2/day API bill (the daily
# web-search-grounded article generation was the driver). Override to an
# Opus id here per-environment if you want the flagship writing back on Opus.
STUDIO_AI_MODEL=claude-sonnet-4-6
STUDIO_AI_THINKING_TOKENS=4000
STUDIO_AI_MAX_TOKENS=2048

# Sprint 4.2 — Supabase Storage bucket for in-editor image uploads.
# Optional; defaults to "studio-uploads" (the name used by the migration
# at docs/migrations/2026-05-14-studio-uploads-bucket.sql). Override
# only if you renamed the bucket on the Supabase project.
STUDIO_UPLOADS_BUCKET=studio-uploads

# Sprint 5 — AI-rendered hero images.
# Required for the "✨ Generate hero" button in the Studio Editor's
# frontmatter form. Mint at https://replicate.com/account/api-tokens.
# Cost: ~$0.003 per FLUX schnell hero. Off by default — the editor
# surfaces a "image_gen_unconfigured" error when unset.
REPLICATE_API_TOKEN=r8_...
# Optional overrides for the image-gen pipeline; defaults work for
# everyone. Provider defaults to "replicate"; model to flux-schnell;
# aspect to 16:9; format to webp.
# STUDIO_IMAGE_GEN_PROVIDER=replicate
# STUDIO_IMAGE_GEN_MODEL=black-forest-labs/flux-schnell
# STUDIO_IMAGE_GEN_ASPECT=16:9
# STUDIO_IMAGE_GEN_FORMAT=webp

# Sprint 5.6 — Local FLUX via ComfyUI (alternate provider).
# Dev-mode only — Vercel production can't reach localhost. Set on
# .env.local (NOT .env.example, NOT Vercel) to route hero generation
# to your own Mac's GPU when running `npm run dev`. See the runbook
# at docs/runbooks/local-flux-comfy.md for setup steps (install
# ComfyUI + download the flux1-schnell-fp8.safetensors checkpoint).
# Zero per-image cost; ~30–90 s/image on M-series.
# STUDIO_IMAGE_GEN_PROVIDER=local-comfy
# STUDIO_LOCAL_COMFY_URL=http://127.0.0.1:8188
# STUDIO_LOCAL_COMFY_CKPT=flux1-schnell-fp8.safetensors

# Sprint — Auto-publish pipeline. Daily Claude-Cowork articles get
# auto-ingested into the studio, run through Suggest frontmatter, and
# Tarry receives a "preview ready" email with one-click publish.
# See the runbook at docs/runbooks/auto-publish-pipeline.md.
#
# Mint both secrets fresh; they MUST NOT match each other or any
# other secret on the project:
#   openssl rand -hex 32
STUDIO_INGEST_SECRET=
STUDIO_APPROVAL_SECRET=
# Resend API key (independent of realai-crm's). Mint at resend.com.
# Sender domain must be verified on Resend (tarrysingh.com SPF/DKIM/DMARC).
RESEND_API_KEY=re_...
# Optional — recipient + From override (defaults shown):
# STUDIO_APPROVAL_EMAIL=tarry.singh@deepkapha.com
# STUDIO_APPROVAL_FROM="Studio · Dispatches <studio@tarrysingh.com>"
