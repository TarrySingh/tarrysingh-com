# Copy this to .env.local and fill in your values

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Site URL (used for Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://tarrysingh.com

# PANORAIMA Dashboard (Basic Auth on /experiments/panoraima/*)
PANORAIMA_USER=utrecht
PANORAIMA_PASS=@dm1n_s3cur3

# RealAI-CRM webhook bridge (Dispatches newsletter → CRM contact + cadence)
# Posts HMAC-SHA256-signed payloads to RealAI-CRM at /api/webhooks/tarrysingh.
# Set on the DK AI Lab Pro Vercel project across Dev / Preview / Prod.
# When CRM_WEBHOOK_URL is empty the /api/newsletter/subscribe handler falls
# back to log-only mode (still returns 200 to the form) so subscriptions
# are never lost during CRM downtime.
CRM_WEBHOOK_URL=https://crm.realai.eu/api/webhooks/tarrysingh
CRM_WEBHOOK_SECRET=replace-with-shared-secret-from-realai-crm
CRM_UNSUBSCRIBE_TOKEN_SECRET=replace-with-different-shared-secret

# LinkedIn syndication bridge (Dispatches blog post → LinkedIn ugcPosts)
# tarrysingh-com never sees the LinkedIn OAuth token — the token is stored
# in RealAI-CRM and the CRM dispatches the actual ugcPosts call. This site
# only signs and forwards a SyndicationPayloadV1 to the CRM.
# When LINKEDIN_SYNDICATION_URL is empty the route falls back to log-only.
LINKEDIN_SYNDICATION_URL=https://crm.realai.eu/api/integrations/linkedin/syndicate
LINKEDIN_SYNDICATION_SECRET=replace-with-shared-secret-from-realai-crm
# Deploy-only admin token for /api/integrations/linkedin/{syndicate,preview}.
# Tarry or the publish hook calls these endpoints with this header:
#   X-Tarrysingh-Admin-Token: <value>
# Fail-closed at 503 when unset, 401 on mismatch. Never expose this to the
# client.
LINKEDIN_ADMIN_TOKEN=replace-with-long-random-string
