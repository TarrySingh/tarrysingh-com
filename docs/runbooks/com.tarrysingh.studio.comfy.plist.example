<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sprint 5.6 — auto-start ComfyUI on every macOS login.
  Save this file to ~/Library/LaunchAgents/com.tarrysingh.studio.comfy.plist
  with USERNAME replaced by your macOS short username, then run:

    launchctl load ~/Library/LaunchAgents/com.tarrysingh.studio.comfy.plist

  ComfyUI will now start at every login and auto-restart if it crashes.
  Logs go to ~/Library/Logs/studio-comfy.log.

  To stop:     launchctl unload ~/Library/LaunchAgents/com.tarrysingh.studio.comfy.plist
  To restart:  launchctl kickstart -k gui/$(id -u)/com.tarrysingh.studio.comfy

  See docs/runbooks/local-flux-comfy.md for full setup.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tarrysingh.studio.comfy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/ComfyUI/venv/bin/python</string>
        <string>/Users/USERNAME/ComfyUI/main.py</string>
        <string>--listen</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8188</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/ComfyUI</string>

    <!-- Inherit PATH + Homebrew so `python` resolves cleanly. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/USERNAME/ComfyUI/venv/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Start at login. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Auto-restart if ComfyUI crashes or exits unexpectedly. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Don't let macOS aggressively throttle this — it's interactive
         even though it's headless. Keeps GPU access responsive. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- Centralised logs (read with: tail -f ~/Library/Logs/studio-comfy.log) -->
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/studio-comfy.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/studio-comfy.log</string>

    <!-- Throttle restart attempts so a broken venv doesn't spin in a tight loop. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
